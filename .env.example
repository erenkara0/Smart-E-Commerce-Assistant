# ==================================================
# Smart E-Commerce Assistant - Environment Template
# ==================================================
# Copy this file as ".env" for local backend and
# Docker Compose configuration.
# Never commit real API keys or secrets.

# ==================================================
# Application
# ==================================================
APP_ENV=development

# JSON array containing allowed frontend origins.
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
CORS_ALLOW_CREDENTIALS=false

# ==================================================
# OpenAI / LLM
# ==================================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2

# ==================================================
# RAG Settings
# ==================================================
RETRIEVAL_TOP_K=2
RAG_MAX_CONTEXT_CHARS=4000
VECTOR_STORE_PROVIDER=in_memory

# ==================================================
# Database / SQLite
# ==================================================
SQLITE_DB_PATH=./backend/storage/app.db

# ==================================================
# Session / Memory
# ==================================================
SESSION_MEMORY_LIMIT=5

# ==================================================
# LangSmith / Observability
# ==================================================
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=smart-e-commerce-assistant
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
